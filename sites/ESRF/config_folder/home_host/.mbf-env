TANGO_HOST=acs.esrf.fr:10000,acs.esrf.fr:11000
LD_LIBRARY_PATH=/opt/os/lib:/opt/os/lib/classes:/lib:/usr/lib:/usr/local/lib:/opt/os/epics/local/lib/linux-x86_64:/opt/host/pythonIoc/softIocApp/O.linux-x86_64

EPICS_CA_MAX_ARRAY_BYTES=1048576

# This is important to avoid a flood of messages in journalctl
EPICS_CA_AUTO_ADDR_LIST=NO
EPICS_CA_ADDR_LIST=
EPICS_CA_NAME_SERVERS="localhost:5164 localhost:5165"

# This is not necessary with the previous lines
#EPICS_CAS_AUTO_BEACON_ADDR_LIST=NO
#EPICS_CAS_BEACON_ADDR_LIST=160.103.11.255
#EPICS_CAS_INTF_ADDR_LIST=enp1s0f3

EPICS_BASE=/opt/os/epics/local
EPICS_HOST_ARCH=linux-x86_64

PATH=/opt/os/epics/local:bin/linux-x86_64:/opt/os/epics/local/bin/linux-x86_64:/operation/common/miniconda3/bin:/operation/common/miniconda3/condabin:/usr/local/bin:/usr/bin:/bin:/usr/local/games:/usr/games:/opt/os/bin:/opt/os/script:/opt/os/util:/opt/os/python/scripts:/opt/puppetlabs/bin:/opt/host/pythonIoc/softIocApp/O.linux-x86_64

TANGO_INTF=enp1s0f3
CONDA_ENV=py37-mbf

# Config settings for building at ESRF

SITE = ESRF

# Override default and install targets for make
DEFAULT_TARGETS = driver python epics iocs
INSTALL_TARGETS = $(DEFAULT_TARGETS)

# Place the driver build on the local filesystem
# so that root have write access
DRIVER_BUILD_DIR = /tmp/mbf/build

# Definitions needed for FPGA build and simulation
FPGA_BUILD_DIR = /dev/shm/MBF-fpga
SIM_BUILD_DIR = /machfs/beroche/mbf/sim/build/sim

VIVADO = /machfs/beroche/vivado/viva192/Vivado/2019.2/settings64.sh
VSIM = /cae/soft/qsim106c/questasim/bin/vsim
LM_LICENSE_FILE = \
    2100@licsrv-el \
    1717@licsrv-el

# Server to connect to for loading FPGA image followed by IP of card
AMC525_SERVER = l-mbf-4 199


# Definitions needed for EPICS driver build
#
EPICS_DEVICE = /opt/mbf/epics_device
EPICS_BASE = /opt/mbf/epics-base

# Permissions for the driver
DRV_GROUP = 1104

# Location of Matlab compiler
MEX = /sware/com/matlab_2017a/bin/mex

# Path to Python executable used for the tunefit IOC
TUNEFIT_PYTHON = /opt/mbf/venvs/venv_tunefit/bin/python3

